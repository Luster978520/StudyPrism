<UserControl x:Class="PrismBaseObj.Views.DialogUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrismBaseObj.Views"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="800"
             >

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window" >
            <Setter Property="Height" Value="900"/> 
            <Setter Property="Width" Value="400"/>
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome GlassFrameThickness="0" ResizeBorderThickness="5" CaptionHeight="0" CornerRadius="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid Background="AliceBlue">
        <StackPanel>
            <TextBlock  Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Background="Pink" FontSize="20" Width="100" Height="50"></TextBlock>
        <Button Width="300" Height="100" Command="{Binding closedCmmd}" Style="{StaticResource GlowButtonAuroraStyle}" Content="关闭"></Button>
            <Button Width="300" Command="{Binding receiveCmmd}" Height="100" Style="{StaticResource GlowButtonAuroraStyle}" Content="UserControl"></Button>
            <Button Content="关闭当前窗口" Width="200" Height="100" Command="{Binding closedCmmd}" Style="{StaticResource GlowButtonSunsetStyle}">

            </Button>
        </StackPanel>
     
    </Grid>
</UserControl>
