<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Geometry x:Key="LiquidTriangleGeometry">
        M 71,20 Q 80,5 89,20 L 146,115 Q 155,130 137.5,130 L 22.5,130 Q 5,130 14,115 Z
    </Geometry>

    <!-- ============================================================== -->
    <!-- 2. 核心样式：液态玻璃霓虹渐变三角形按钮                        -->
    <!-- ============================================================== -->
    <Style x:Key="LiquidGlassTriangleButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="168"/>
        <Setter Property="Height" Value="144"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- 缩放与旋转中心对准三角形几何重心 (水平 0.5, 垂直约 0.65) -->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.65"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- 外部留出充足 Margin 容纳外发光，防止阴影被父容器裁剪 -->
                    <Grid Width="168" Height="144" Background="{x:Null}">

                        <!-- [第1层] 外围淡紫外发光层 (轻盈扩散，不厚重) -->
                        <Path x:Name="OuterGlowPath"
                                  Data="{StaticResource LiquidTriangleGeometry}"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="#C084FC"
                                  StrokeThickness="3"
                                  Fill="#18C084FC"
                                  IsHitTestVisible="False">
                            <Path.Effect>
                                <DropShadowEffect x:Name="PurpleOuterGlow"
                                                      Color="#C084FC"
                                                      ShadowDepth="0"
                                                      BlurRadius="22"
                                                      Opacity="0.55"/>
                            </Path.Effect>
                        </Path>

                        <!-- [第2层] 底层蓝紫青对角线流动渐变层 (带轻微高斯磨砂模糊) -->
                        <Path x:Name="FluidGradientPath"
                                  Data="{StaticResource LiquidTriangleGeometry}"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Opacity="0.82">
                            <Path.Fill>
                                <!-- StartPoint(0,0) 到 EndPoint(1,1) 构成对角线渐变 -->
                                <!-- SpreadMethod="Reflect" 实现镜像无缝循环流动 -->
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,0.7" SpreadMethod="Reflect">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="DiagonalFlowTransform" X="0" Y="0"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#60A5FA" Offset="0.0"/>
                                    <!-- 柔和冰蓝 -->
                                    <GradientStop Color="#C084FC" Offset="0.5"/>
                                    <!-- 柔和淡紫 -->
                                    <GradientStop Color="#22D3EE" Offset="1.0"/>
                                    <!-- 清透浅青 -->
                                </LinearGradientBrush>
                            </Path.Fill>
                            <Path.Effect>
                                <!-- 轻微磨砂模糊，使三色过渡呈现液态散射质感 -->
                                <BlurEffect Radius="8" KernelType="Gaussian"/>
                            </Path.Effect>
                        </Path>

                        <!-- [第3层] 半透奶白玻璃质感层 (核心层：柔化底色，适配白底不刺眼) -->
                        <Path x:Name="MilkyGlassPath"
                                  Data="{StaticResource LiquidTriangleGeometry}"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="MilkStop1" Color="#C4FFFFFF" Offset="0.0"/>
                                    <GradientStop x:Name="MilkStop2" Color="#96F8FAFC" Offset="0.5"/>
                                    <GradientStop x:Name="MilkStop3" Color="#B5FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- [第4层] 液态玻璃曲面高光折射层 (提升通透立体感) -->
                        <Path x:Name="LiquidHighlightPath"
                                  Data="{StaticResource LiquidTriangleGeometry}"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.2,0.0" EndPoint="0.6,0.7">
                                    <GradientStop Color="#95FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#20FFFFFF" Offset="0.45"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- [第5层] 细霓虹光边层 (主色浅冰蓝，局部流转淡紫高光) -->
                        <Path x:Name="NeonBorderPath"
                                  Data="{StaticResource LiquidTriangleGeometry}"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  IsHitTestVisible="False">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="BorderStop1" Color="#E0F2FE" Offset="0.0"/>
                                    <!-- 极亮冰白蓝 -->
                                    <GradientStop x:Name="BorderStop2" Color="#38BDF8" Offset="0.4"/>
                                    <!-- 主色浅冰蓝 -->
                                    <GradientStop x:Name="BorderStop3" Color="#67E8F9" Offset="0.75"/>
                                    <!-- 霓虹浅青蓝 -->
                                    <GradientStop x:Name="BorderStop4" Color="#D8B4FE" Offset="1.0"/>
                                    <!-- 尾端淡紫过渡 -->
                                </LinearGradientBrush>
                            </Path.Stroke>
                            <Path.Effect>
                                <!-- 紧贴边框的浅冰蓝微发光，塑造细霓虹灯管质感 -->
                                <DropShadowEffect x:Name="IceBlueNeonGlow"
                                                      Color="#38BDF8"
                                                      ShadowDepth="0"
                                                      BlurRadius="6"
                                                      Opacity="0.65"/>
                            </Path.Effect>
                        </Path>

                        <!-- [第6层] 独立内容呈现层 (无任何位图特效，确保文字清晰锐利) -->
                        <!-- Margin="0,34,0,0" 将文字从矩形中点下移至正三角形的视觉重心 -->
                        <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,34,0,0"
                                              RecognizesAccessKey="True"
                                              IsHitTestVisible="False"/>
                    </Grid>

                    <!-- ========================================================== -->
                    <!-- 触发器与状态机：常态对角线流动 + 悬停提亮 + 按压微缩       -->
                    <!-- ========================================================== -->
                    <ControlTemplate.Triggers>
                        <!-- 1. 控件加载时：启动对角线 (X与Y同步递增) 无限流光动画 -->
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="DiagonalFlowTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="0.0" To="1.4"
                                                         Duration="0:0:4.5"/>
                                    <DoubleAnimation Storyboard.TargetName="DiagonalFlowTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         From="0.0" To="1.4"
                                                         Duration="0:0:4.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- 2. 鼠标悬停：奶白层微透出更多流光 + 冰蓝边更亮 + 淡紫外发光微微扩张 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 稍微降低奶白层不透明度，让底层蓝紫青流光更绚丽 -->
                                        <ColorAnimation Storyboard.TargetName="MilkStop1"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#A8FFFFFF" Duration="0:0:0.2"/>
                                        <ColorAnimation Storyboard.TargetName="MilkStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#78F8FAFC" Duration="0:0:0.2"/>
                                        <!-- 增强外围淡紫外发光扩散感 -->
                                        <DoubleAnimation Storyboard.TargetName="PurpleOuterGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="28" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="PurpleOuterGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.8" Duration="0:0:0.2"/>
                                        <!-- 增强浅冰蓝霓虹边框光感 -->
                                        <DoubleAnimation Storyboard.TargetName="IceBlueNeonGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="10" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="IceBlueNeonGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.95" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="MilkStop1"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#C4FFFFFF" Duration="0:0:0.25"/>
                                        <ColorAnimation Storyboard.TargetName="MilkStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#96F8FAFC" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="PurpleOuterGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="22" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="PurpleOuterGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.55" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="IceBlueNeonGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="6" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="IceBlueNeonGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.65" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 3. 鼠标按下：围绕三角形重心弹性微缩至 0.94 倍 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.94" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.94" Duration="0:0:0.08"/>
                                        <ColorAnimation Storyboard.TargetName="BorderStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#0284C7" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.14"/>
                                        <ColorAnimation Storyboard.TargetName="BorderStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#38BDF8" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 4. 禁用状态：收敛霓虹发光，转为静谧磨砂灰 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterGlowPath" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="FluidGradientPath" Property="Opacity" Value="0.15"/>
                            <Setter TargetName="NeonBorderPath" Property="Stroke" Value="#CBD5E1"/>
                            <Setter TargetName="NeonBorderPath" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>