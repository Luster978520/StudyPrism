<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ========================================================== -->
    <!-- 样式 1：现代主按钮 (ModernPrimaryButton) - 渐变蓝 + 弥散阴影 -->
    <!-- ========================================================== -->
    <Style x:Key="ModernPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- 设置变换中心点为正中心 (0.5, 0.5)，确保按压缩放时不偏位 -->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <!-- 第1层：独立阴影层 (与文字分离，防止DropShadowEffect导致文字模糊) -->
                        <Border x:Name="ShadowBorder"
                                    CornerRadius="8"
                                    Background="#2563EB"
                                    Opacity="0.85">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ButtonShadow"
                                                      Color="#2563EB"
                                                      Direction="270"
                                                      ShadowDepth="4"
                                                      BlurRadius="14"
                                                      Opacity="0.35"/>
                            </Border.Effect>
                        </Border>

                        <!-- 第2层：主体背景层 -->
                        <Border x:Name="MainBorder"
                                    CornerRadius="8"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="GradStop1" Color="#3B82F6" Offset="0.0"/>
                                    <GradientStop x:Name="GradStop2" Color="#2563EB" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <!-- 第3层：内容呈现层 (位于无特效的Border内，保持ClearType锐利度) -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>

                    <!-- 交互状态触发器 -->
                    <ControlTemplate.Triggers>
                        <!-- 1. 鼠标悬停：背景提亮 + 阴影扩散 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="GradStop1"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#60A5FA" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="GradStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#3B82F6" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="18" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="GradStop1"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#3B82F6" Duration="0:0:0.2"/>
                                        <ColorAnimation Storyboard.TargetName="GradStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#2563EB" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="14" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 2. 鼠标按下：微缩放弹性反馈 + 颜色加深 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.96" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.96" Duration="0:0:0.08"/>
                                        <ColorAnimation Storyboard.TargetName="GradStop1"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#2563EB" Duration="0:0:0.08"/>
                                        <ColorAnimation Storyboard.TargetName="GradStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#1D4ED8" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 3. 禁用状态：置灰且隐藏阴影 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MainBorder" Property="Background" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== -->
    <!-- 样式 2：现代次要按钮 (ModernSecondaryButton) - 极简白底微边框 -->
    <!-- ========================================================== -->
    <Style x:Key="ModernSecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <!-- 底层极淡阴影 -->
                        <Border x:Name="ShadowBorder"
                                    CornerRadius="8"
                                    Background="#FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect Color="#64748B"
                                                      Direction="270"
                                                      ShadowDepth="2"
                                                      BlurRadius="6"
                                                      Opacity="0.08"/>
                            </Border.Effect>
                        </Border>

                        <!-- 表层主体 -->
                        <Border x:Name="MainBorder"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 悬停：背景变为极浅冷灰，边框加深，文字变深 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#F8FAFC"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#94A3B8"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                        </Trigger>
                        <!-- 按下：背景进一步加深 + 微缩 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#F1F5F9"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#64748B"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.96" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.96" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 禁用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MainBorder" Property="Background" Value="#F8FAFC"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>